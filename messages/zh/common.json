  "program": {
    "hero": {
      "badge": "社会影响力倡议",
      "title": "勤奋的学校发展计划",
      "subtitle": "为缺乏经济资源的学校免费提供现代学习技术"
    },
    "commitment": {
      "revenue": "已承诺收入",
      "cohort": "首批学员启动",
      "free": "免费访问"
    },
    "about": {
      "mission": {
        "title": "我们的使命",
        "body1": "“勤奋学习学校发展计划”旨在通过为弱势学校提供免费、无限量的学习管理平台访问权限来支持它们。我们认识到，技术是未来劳动力市场的关键因素，但许多教育机构却缺乏此类资源。通过该计划，我们将现代化的学习管理技术带给最需要的学校。"
      },
      "aims": {
        "title": "项目目标",
        "body1": "通过与教师和教育专业人士的深入交流，我们发现许多学校可用的数字化学习基础设施存在显著缺陷。市面上许多学习管理系统缺乏统一、直观的用户体验，而贫困地区的学校往往无力负担现代教育技术。",
        "body2": "我们的项目旨在直接应对这些挑战。通过机构付费订阅获得的收入，我们能够为资源匮乏的学校提供全面的 Studious LMS 学习管理系统及相关教育工具的使用权限。这种可持续的模式使我们能够弥合数字鸿沟，同时不断改进平台，造福所有用户。"
      },
      "receive": {
        "title": "您将收到",
        "body1": "入选该项目的学校将获得完整的 Studious 平台体验，而非功能受限或精简版。这包括无限量的学生和教师账户、所有高级功能（人工智能助手、高级分析、实时协作）、优先技术支持、专属入职培训专家、持续的培训资源，以及所有未来更新和改进的访问权限。",
        "body2": "除了软件本身，我们还提供全面的支持，确保您的学校能够最大限度地发挥平台的优势。我们的团队将与您的管理人员和教师直接合作，根据您的具体需求定制系统，提供实践培训，并在整个使用过程中随时为您提供持续的帮助。"
      },
      "qualifies": {
        "title": "谁有资格？",
        "body1": "我们优先考虑那些最能从教育技术改进中受益的学生所在的学校。这包括服务不足或经济困难社区的公立学校、面临财务困境的注册非营利教育机构、发展中国家或地区的学校、美国第一类学校及其国际对应学校，以及任何能够证明自身确实存在财务需求并致力于提升学生学习成果的教育机构。",
        "body2": "我们会对每份申请进行单独评估，不仅考虑财务指标，还会考虑贵校的使命、服务对象以及您利用 Studious 提升教育的计划。我们的目标是与真正能够从我们的平台受益并有效利用该平台来改善学生学习体验的学校合作。"
      },
      "impact": {
        "title": "我们追求影响力的愿景",
        "body1": "通过为学校免费提供现代化的学习管理技术，我们旨在消除贫困地区教育机构面临的主要障碍之一。我们的方法不仅限于软件——我们致力于提供全面的支持，包括培训资源、新用户指导以及电子书和电子文具等教育工具。",
        "body2": "学校发展计划将于2025年11月下旬至12月中旬启动，首批合作学校将加入该计划。随着Studious的发展壮大，我们支持更多学校的能力也将随之提升。所有机构付费订阅收入都将重新投入，用于扩大有需要学校的资源，从而创建一个可持续的教育公平模式，并随着时间的推移不断完善。"
      }
    },
