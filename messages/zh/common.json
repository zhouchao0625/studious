  "about": {
    "titleStatement1": "我们的故事",
    "titleStatement2": "源于挫败感，",
    "titleStatement3": "利用人工智能重新构想",
    "titleStatement4": "多年来，我们一直苦于使用过时、分散的学校门户网站，因此我们决定构建我们一直梦寐以求的学习管理系统。",
    "problemParagraph1": "学习始于2023年",
    "problemParagraph2": "当一群学生和教育工作者因为共同的挫败感而聚集在一起时：现有的学校门户网站笨拙、缓慢，而且是为不同的教育时代而设计的。",
    "problemDetailParagraph": "我们发现自己需要同时管理多个平台——一个用于成绩，一个用于作业，还有一个用于沟通。老师们花在与软件较劲上的时间比教学时间还多。学生们因为通知被隐藏在过时的界面中而错过截止日期。",
    "betterWay": "我们知道一定有更好的办法。",
    "solutionParagraph1": "我们从 Linear 和 Notion 等现代协作工具中汲取灵感，着手创建一个让人感觉舒适的学习管理系统。",
    "solutionParagraph2": "快速、直观、使用起来令人愉悦。",
    "solutionParagraph3": "它将人工智能融入教学，不是为了噱头，而是为了真正提高教师和学生的生产力。",
    "launchParagraph": "经过两年的研发，我们于 2025 年 10 月 17 日正式发布了 Studious。目前我们正处于早期体验阶段，准备帮助全球学校革新学习体验。",
    "journey1": "我们的旅程",
    "journey2": "两年的建设、学习和成长",
    "journeyBeginningDate": "2023",
    "journeyBeginning1": "开端",
    "journeyBeginning2": "首个原型已完成。核心功能包括：课程管理、作业布置和日历集成。",
    "journeyBetaLaunchDate": "2025年10月31日",
    "journeyBetaLaunch1": "公开测试版发布",
    "journeyBetaLaunch2": "Studious LMS正式上线公开测试版。面向全球学校开放，提供完整平台功能的抢先体验。",
    "journeyPilotSchoolsDate": "2025年11月",
    "journeyPilotSchools1": "试点学校计划",
    "journeyPilotSchools2": "与试点学校建立合作关系，收集真实世界的反馈，并根据不同的教育需求改进平台。",
    "journeyBetaCompleteDate": "2025年12月",
    "journeyBetaComplete1": "Beta 测试完成",
    "journeyBetaComplete2": "从测试版过渡到正式版。平台稳定性已得到提升，所有核心功能均已全面测试和优化。",
    "journeySDPDate": "2026年1月",
    "journeySDP1": "学校发展计划启动",
    "journeySDP2": "宣布首批入选“勤奋好学学校发展计划”的学校名单，该计划将为符合条件的院校提供免费学习机会。",
    "missionStatement1": "我们的使命很简单。",
    "missionStatement2": "构建一个我们——作为学生、教师和终身学习者——每天都想使用的学习管理系统。",
